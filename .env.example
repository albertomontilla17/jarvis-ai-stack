# Copia este archivo a ".env" EN LA COMPUTADORA QUE EJECUTA LOS TRADES y rellénalo.
# ".env" está en .gitignore: nunca se sube al repo ni a la nube.

# ── Wallet (solo en la computadora local) ────────────────────────────────────
# Clave privada de la wallet que firma las órdenes. Usa una wallet DEDICADA al
# bot, con poco saldo — nunca la clave de tu wallet principal.
POLYMARKET_PRIVATE_KEY=0xREEMPLAZA_CON_TU_CLAVE_PRIVADA

# Dirección que tiene los fondos en Polymarket (la que ves en tu perfil).
POLYMARKET_FUNDER_ADDRESS=0xREEMPLAZA_CON_TU_DIRECCION

# 0 = wallet normal (MetaMask/Rabby, tú tienes la clave y los fondos están en ella)
# 1 = cuenta creada con email / Magic en polymarket.com
# 2 = cuenta de polymarket.com conectada con wallet de navegador (proxy)
POLYMARKET_SIGNATURE_TYPE=0

# ── Límites duros del ejecutor local (USD) ───────────────────────────────────
JARVIS_MAX_PER_TRADE=5
JARVIS_MAX_PER_DAY=15
JARVIS_ALLOWED_CATEGORIES=sports,finance_prices,economics
# Rechaza la orden si el precio se movió más que esto desde la propuesta
JARVIS_MAX_SLIPPAGE=0.03

# ── Opcional: solo si reactivas el análisis con Claude ───────────────────────
ANTHROPIC_API_KEY=sk-ant-REEMPLAZA_SI_LO_USAS
